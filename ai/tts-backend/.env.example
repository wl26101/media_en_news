# Copy to .env (or export directly) to override defaults.
# The app reads these from the process environment.

# --- Model ------------------------------------------------------------------
# Path or HF repo id of a Qwen3-TTS checkpoint.
# Base (voice clone)            -> Qwen3-TTS-12Hz-0.6B-Base
# VoiceDesign (tone control)    -> Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# CustomVoice (preset speakers) -> Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
MODEL_PATH=../../Qwen3-TTS-12Hz-0.6B-Base

# cuda:0 / cpu
DEVICE=cuda:0
# bfloat16 / float16 / float32
DTYPE=bfloat16
# flash_attention_2 if flash-attn is installed, else leave empty (sdpa)
ATTN_IMPL=

# --- Built-in voice-clone reference (same defaults as test.py) --------------
# Used by the Base model when a request omits ref_audio / ref_text.
DEFAULT_REF_AUDIO=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-TTS-Repo/clone.wav
DEFAULT_REF_TEXT=Okay. Yeah. I resent you. I love you. I respect you. But you know what? You blew it! And thanks to you.

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8081
OUTPUT_DIR=outputs

# --- Generation defaults (optional; per-request params override these) ------
# TEMPERATURE=0.9
# TOP_P=1.0
# TOP_K=50
# REPETITION_PENALTY=1.05
# MAX_NEW_TOKENS=2048

# Serialize concurrent requests against the GPU (default: true)
SERIALIZE_REQUESTS=true
