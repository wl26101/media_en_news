      "image_file": "/home/wl26/project/media_en_news/resource/images/news_019.png",
      "status": "ok"
    },
    {
      "index": 20,
      "text": "Araghchi reiterated that as part of the agreement to end the conflict, Iran is willing to reopen the Strait.",
      "text_file": "/home/wl26/project/media_en_news/resource/text/news_020.txt",
      "prompt_file": "/home/wl26/project/media_en_news/resource/image_prompt/news_020.txt",
